apiVersion: v1
kind: Secret
metadata:
  name: ostad-secrets
  namespace: aninda-sarker-rahul-ns
type: Opaque
data:
  # Base64 encoded values - REPLACE WITH YOUR OWN VALUES
  # To encode: echo -n "your_value" | base64
  # Examples below use default values - CHANGE THESE IN PRODUCTION!
  
  # MongoDB credentials
  MONGO_ROOT_USERNAME: <base64_encoded_username>  # Default: YWRtaW4= (admin)
  MONGO_ROOT_PASSWORD: <base64_encoded_password>  # Default: cGFzc3dvcmQ= (password)
  
  # Mongo Express credentials  
  ME_CONFIG_BASICAUTH_USERNAME: <base64_encoded_username>  # Default: YWRtaW4= (admin)
  ME_CONFIG_BASICAUTH_PASSWORD: <base64_encoded_password>  # Default: cGFzc3dvcmQ= (password)

# Instructions:
# 1. Copy this file to secret.yaml
# 2. Replace <base64_encoded_*> with your actual base64 encoded values
# 3. To generate base64: echo -n "your_secret" | base64
# 4. Apply: kubectl apply -f k8s/secret.yaml
