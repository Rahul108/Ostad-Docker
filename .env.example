# MongoDB credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password

# MongoDB database name
MONGO_DATABASE=ostaddb

# MongoDB connection string (used by backend)
MONGO_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongo:27017/${MONGO_DATABASE}?authSource=admin

# Mongo Express credentials (same as MongoDB for simplicity)
ME_CONFIG_MONGODB_ADMINUSERNAME=${MONGO_ROOT_USERNAME}
ME_CONFIG_MONGODB_ADMINPASSWORD=${MONGO_ROOT_PASSWORD}

# Image versions
SERVER_IMAGE_VERSION=latest
UI_IMAGE_VERSION=latest